{
  "version": "0.2",
  "language": "en",
  "dictionaries": ["lorem-ipsum"],
  "ignorePaths": [
    "package.json",
    "package-lock.json",
    "node_modules",
    "vscode-extension",
    ".git/{info,lfs,logs,refs,objects}/**",
    ".git/{index,*refs,*HEAD}",
    ".vscode",
    ".vscode-insiders",
    "**/*.json",
    "**/*.md"
  ],
  "ignoreRegExpList": ["/%[0-9A-Fa-f]{2}/g"],
