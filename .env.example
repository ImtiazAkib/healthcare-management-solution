# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Absolute origin the app is served from. Used for absolute links and metadata.
APP_BASE_URL=http://localhost:3000

# Allow search engines to index the site. Off by default so staging stays out of
# the index — set to true only on production.
ROBOTS_ENABLED=false

# MongoDB connection string. Required.
# The database name is NOT taken from this string — the app passes it explicitly, so
# an Atlas URI pasted without its path segment still writes to the right database.
# Local:   mongodb://127.0.0.1:27017/healthcare-management
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign session tokens, at least 32 characters. Required.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Total bytes the GridFS lab-report bucket may hold (step 12). Optional — defaults
# to 1 GiB. The per-file cap and the upload quota guard are measured against this.
STORAGE_CAP_BYTES=

# How verification and password-reset emails are delivered (step 15). Optional —
# defaults to `log`, which writes each email (with its link) to the logger, so the
# whole registration flow can be walked with no mail server. Set to `smtp` to send.
MAIL_TRANSPORT=log

# SMTP settings. Read only when MAIL_TRANSPORT=smtp; leave blank on the log transport.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The From address on outgoing mail, e.g. "Hospital <no-reply@hospital.example>".
SMTP_FROM=

# How SMS notifications are delivered (step 18). Optional — defaults to `log`, which
# writes each SMS to the logger instead of sending it. Only the logging transport
# ships; a real provider (e.g. twilio) is one driver away.
SMS_TRANSPORT=log

# SMS provider settings. Read only when SMS_TRANSPORT is not `log`; leave blank otherwise.
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
# The sender id or number shown on outgoing SMS.
SMS_FROM=

# --- Seeding only -----------------------------------------------------------
# Read by `npm run seed:super-admin`, never by the app. Set them for that one
# command rather than committing them here, so the password stays out of the repo:
#
#   SEED_SUPER_ADMIN_NAME="Hospital Director" \
#   SEED_SUPER_ADMIN_EMAIL="director@hospital.example" \
#   SEED_SUPER_ADMIN_PASSWORD="..." \
#   npm run seed:super-admin
